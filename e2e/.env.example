# Use a deployed/preview web URL, or let Playwright start the local Vite app with
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY available to that process.
E2E_WEB_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# A dedicated, consented patient account with no sensitive production data.
E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
