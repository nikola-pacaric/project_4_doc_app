{
  "name": "project-4-doc-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @project4/web",
    "dev:mobile": "npm run start -w @project4/mobile",
    "dev:android": "npm run android:native -w @project4/mobile",
    "build:web": "npm run build -w @project4/web",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run --passWithNoTests --exclude=e2e/**",
    "test:e2e:web": "playwright test",
    "test:e2e:web:list": "playwright test --list",
    "test:smoke:mobile:list": "node e2e/mobile/list-flows.mjs",
    "test:smoke:mobile:validate": "prettier --check .maestro",
    "test:smoke:mobile:auth": "maestro test .maestro/auth-routing.yaml",
    "test:smoke:mobile": "node e2e/mobile/run-patient-timeline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "1.62.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "prettier": "latest",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
